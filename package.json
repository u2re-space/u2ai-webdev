{
  "name": "@u2ai/webdev",
  "version": "0.3.0-alpha",
  "description": "AI web developer: plans a web project, generates markup, code, styles and components, picks the icons and the setup, and reviews the result.",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./shared": "./src/shared/shared.js",
    "./protocol": "./src/shared/protocol.js",
    "./worker": "./src/shared/worker.js",
    "./code-mode": "./src/shared/code-mode.js",
    "./code-libraries": "./src/shared/code-libraries.js",
    "./ramdisk": "./src/access/ramdisk.js"
  },
  "bin": {
    "ai-webdev": "./bin/ai-webdev.js",
    "ai-webdev-worker": "./bin/ai-webdev-worker.js",
    "ai-webdev-agent-worker": "./bin/ai-webdev-agent-worker.js",
    "ai-webdev-code-mode-worker": "./bin/ai-webdev-code-mode-worker.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/u2re-space/u2ai-webdev.git"
  },
  "homepage": "https://github.com/u2re-space/u2ai-webdev#readme",
  "bugs": {
    "url": "https://github.com/u2re-space/u2ai-webdev/issues"
  },
  "engines": {
    "node": ">=26.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "start": "node bin/ai-webdev.js",
    "test": "node --test --test-timeout=60000 --import ./test/offline-guard.js \"test/*.test.js\"",
    "check": "node scripts/check-syntax.mjs",
    "sync:code-mode": "node scripts/sync-code-mode.mjs",
    "sync:access": "node scripts/sync-access.mjs"
  },
  "files": [
    "bin",
    "src",
    "skills",
    "index.js",
    "README.md"
  ],
  "keywords": [
    "openai",
    "responses-api",
    "cli",
    "web-development",
    "codegen",
    "components",
    "design-tokens",
    "icons"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.1",
    "@toon-format/toon": "^4.4.0",
    "@u2ai/subagent": "file:../u2ai-subagent",
    "json5": "^2.2.3",
    "openvector": "^0.1.6",
    "terminal-kit": "^3.1.4"
  },
  "optionalDependencies": {
    "@imagemagick/magick-wasm": "^0.0.46"
  }
}
